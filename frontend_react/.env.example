# Frontend environment variables
# Copy this file to .env and adjust values as needed. These variables are injected at build time.
#
# If your backend runs on a different origin/port, set this to its base URL.
# Examples:
# REACT_APP_API_BASE_URL=http://localhost:8000
# REACT_APP_API_BASE_URL=https://api.example.com
REACT_APP_API_BASE_URL=
