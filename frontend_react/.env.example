# Frontend environment variables for connecting to the FastAPI backend.
# For Create React App, environment variables must be prefixed with REACT_APP_.

# Base URL of the backend API (no trailing slash).
# Leave empty to use same-origin requests (useful when reverse-proxying /api).
# Examples:
# REACT_APP_API_BASE_URL=http://localhost:8000
# REACT_APP_API_BASE_URL=https://api.example.com
REACT_APP_API_BASE_URL=
